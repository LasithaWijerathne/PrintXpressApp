<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ink_charcoal"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_logo_circle"
                android:gravity="center"
                android:textColor="@color/print_magenta"
                android:textSize="22sp"
                android:textStyle="bold"
                android:id="@+id/text_avatar_initial"
                tools:text="N" />

            <TextView
                android:id="@+id/text_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Nadeesha Perera" />

            <TextView
                android:id="@+id/text_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                tools:text="nadeesha@example.com" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/row_saved_designs"
                style="@style/ProfileRow"
                android:text="@string/profile_saved_designs" />

            <View style="@style/ProfileDivider" />

            <TextView
                android:id="@+id/row_addresses"
                style="@style/ProfileRow"
                android:text="@string/profile_addresses" />

            <View style="@style/ProfileDivider" />

            <TextView
                android:id="@+id/row_order_history"
                style="@style/ProfileRow"
                android:text="@string/profile_order_history" />

            <View style="@style/ProfileDivider" />

            <TextView
                android:id="@+id/row_guidelines"
                style="@style/ProfileRow"
                android:text="@string/profile_help_support" />

            <View style="@style/ProfileDivider" />

            <TextView
                android:id="@+id/row_logout"
                style="@style/ProfileRow"
                android:text="@string/profile_logout"
                android:textColor="@color/error" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
